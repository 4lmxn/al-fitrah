# NEXT_PUBLIC_* are inlined into the browser bundle at BUILD time, not read at
# runtime. On Firebase App Hosting the build reads apphosting.yaml; in the
# Dockerfile they must be passed as --build-arg or the browser bundle ships
# empty strings. Everything else is runtime-only and must never reach a build
# layer. See docs/aws-cloudflare.md.

# ─── Site / SEO ──────────────────────────────────────────────────────────────
# Canonical production origin, no trailing slash. Used for metadataBase,
# sitemap.xml, robots.txt, and JSON-LD. Defaults to https://al-fitrah.web.app.
NEXT_PUBLIC_SITE_URL=https://www.alfitrahsarjapura.in
# Coming-soon holding page. "1" rewrites every public route to /coming-soon
# (admin + API stay reachable). Set to "0"/blank to show the full site.
NEXT_PUBLIC_COMING_SOON=
# Public URL of the prospectus / fee-sheet PDF. Until set, the prospectus
# magnet still captures the lead and promises to send it; once set, submitting
# reveals a direct download. e.g. /prospectus.pdf (drop the file in public/).
NEXT_PUBLIC_PROSPECTUS_URL=
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave blank to disable.
NEXT_PUBLIC_GA_ID=
# Google Search Console verification: the content value of the
# "google-site-verification" meta tag (HTML-tag method). Token only, no markup.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Exact campus pin for LocalBusiness schema geo (strongest Maps/local signal).
# Right-click the campus in Google Maps → click the lat,lng to copy. Decimal degrees.
NEXT_PUBLIC_GEO_LAT=
NEXT_PUBLIC_GEO_LNG=

# ─── Firebase (public web config — safe to expose) ───────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=al-fitrah
# Private file store (CVs, students' documents). NOT the Firebase default
# bucket — that one lives in us-east1, and these are children's records. This
# one is asia-south1 with public access prevention enforced; everything is
# streamed through an authenticated route, so it needs no public read path.
# Public post images are refused against a private bucket — see
# publicImagesSupported() in src/lib/storage.ts.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=al-fitrah-files
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Server-only secrets (DO NOT COMMIT real values; set in .env.local) ───────
# Full service-account JSON as a single-line string (local dev). On Firebase
# App Hosting this is unnecessary — Application Default Credentials are used.
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_PROJECT_ID=al-fitrah

# Resend (transactional email for inquiries)
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=
INQUIRY_ADMIN_EMAIL=

# Admin allowlist — comma-separated emails permitted to sign into /admin.
# Login is rejected for any address not listed here. REQUIRED, or no one
# can access the dashboard. e.g. admin@alfitrah.com,owner@alfitrah.com
ADMIN_EMAILS=

# Subset of ADMIN_EMAILS allowed to DELETE things (currently: job openings).
# Everyone else signs in as "staff" — full access to leads and the pipeline,
# but no destructive actions. Comma-separated, must also appear in ADMIN_EMAILS.
# LEAVE BLANK and every admin is an owner, i.e. exactly today's behaviour —
# so adding roles can't lock the school out before this is set.
ADMIN_OWNERS=

# Shared secret guarding the daily follow-up cron (/api/cron/followups).
# Cloud Scheduler must send it as the "x-cron-secret" header. Any long random
# string; without it the cron endpoint returns 401 and no digest is sent.
CRON_SECRET=

# ─── Cloudflare ───────────────────────────────────────────────────────────────
# Shared secret that Cloudflare attaches to every request it forwards, via a
# Transform Rule on the zone (header: x-edge-token). Rate limiting trusts
# CF-Connecting-IP only on requests carrying it — a request arriving straight at
# the origin cannot produce the token, so a spoofed CF-Connecting-IP is ignored.
#
# Leave BLANK until Cloudflare is in front and the Transform Rule exists. Blank
# is safe: nothing trusts the header, and the last x-forwarded-for entry is used
# exactly as it is today. See src/lib/clientIp.ts and
# docs/deploy-cloudrun-cloudflare.md.
EDGE_TOKEN=

# ─── Not yet enabled ──────────────────────────────────────────────────────────
# Referenced by src/lib/notify; both channels stay off while unset.
WHATSAPP_TOKEN=
SMS_TOKEN=
