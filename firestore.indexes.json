{
  "indexes": [
    {
      "//": "Inbox pagination: newest-first within one lead type. Replaces the in-memory sort over a full-collection fetch.",
      "collectionGroup": "leads",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "type",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Inbox pagination with a stage filter applied.",
      "collectionGroup": "leads",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "type",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "stage",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Inbox attention badge + view, half 1: overdue follow-ups. No stage filter is needed because updateStage deletes followUpDate on reaching a terminal stage, so admitted/lost leads are not in this index.",
      "collectionGroup": "leads",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "type",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "followUpDate",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Inbox attention badge + view, half 2: new leads with no notes older than 48h.",
      "collectionGroup": "leads",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "type",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "stage",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "noteCount",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Insights: this month's enquiry count as an aggregation rather than a scan.",
      "collectionGroup": "leads",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "type",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Public careers page: active openings in display order.",
      "collectionGroup": "jobOpenings",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "active",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "order",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Students list: paginated by admission number, optionally filtered by status.",
      "collectionGroup": "students",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "admissionNumber",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Admission-number allocation: highest number issued in an academic year.",
      "collectionGroup": "students",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "academicYear",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "admissionNumber",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Attendance: one class's registers across a date range (monthly summary).",
      "collectionGroup": "attendance",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "academicYear",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "classSection",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "dateKey",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Class roster: enrolled children in one section.",
      "collectionGroup": "students",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "classSection",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        }
      ]
    }
  ],
  "fieldOverrides": []
}
