rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Leads are written only by the server (Admin SDK bypasses these rules).
    // No client may read or write them. The `=**` recursive wildcard is what
    // covers the notes subcollection: `match /leads/{doc}` alone would NOT —
    // a rule matches one path segment unless it is recursive. The catch-all
    // below also denies it, but being explicit here means adding a real client
    // rule for leads later can't silently open the timeline with it.
    match /leads/{doc=**} {
      allow read, write: if false;
    }
    // Students hold children's names, dates of birth and medical notes — the
    // most sensitive data in the system. Server-only, same as leads.
    match /students/{doc=**} {
      allow read, write: if false;
    }
    // Attendance records which child was where on which day. Server-only.
    match /attendance/{doc=**} {
      allow read, write: if false;
    }
    // Staff check-in: who was at work, when, and the coordinates they were at.
    // Staff location history is personal data and the fence is only meaningful
    // if the record cannot be written by the client it judges. Server-only.
    match /staffAttendance/{doc=**} {
      allow read, write: if false;
    }
    // The fee ledger. Server-only, and append-only in application code — a
    // client able to write here could rewrite what a family has paid.
    match /payments/{doc=**} {
      allow read, write: if false;
    }
    // The audit log. Server-only, and append-only in application code — a
    // client able to write here could forge or erase the record of a change.
    match /auditLog/{doc=**} {
      allow read, write: if false;
    }
    // In-app notifications. Server-only: a client able to write here could
    // forge a notice, and one able to read could see other staff's alerts.
    match /notifications/{doc=**} {
      allow read, write: if false;
    }
    // Website content. Reads happen server-side through ISR, so this could be
    // closed too — but posts are, by definition, published to the public, and
    // an accidental client read here leaks nothing. Writes stay server-only.
    match /posts/{doc=**} {
      allow read: if resource.data.published == true;
      allow write: if false;
    }
    // Rate-limit counters. Server-only: a client able to write here could
    // reset its own counter and walk past every limit; one able to read gets
    // a map of which keys are currently being throttled.
    match /rateLimits/{doc=**} {
      allow read, write: if false;
    }
    // Default: deny everything not explicitly allowed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
